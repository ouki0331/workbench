{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "build:cloudstudio": "vite build --config vite.cloudstudio.ts",
    "start:cloudstudio": "node scripts/serve-cloudstudio.mjs",
    "test": "node scripts/progress.test.mjs",
    "lint:app": "oxlint app/page.tsx app/layout.tsx app/api/library/[[...path]]/route.ts lib/progress.ts lib/review.ts lib/assessment.ts lib/analytics.ts lib/i18n.tsx lib/learning-providers.ts lib/cloud-library.ts cloudstudio.tsx vite.cloudstudio.ts vite.config.ts scripts/cloud-library.test.mjs scripts/cloud-migration-smoke.mjs components/study-library.tsx components/global-search.tsx components/import-center.tsx components/practice-workspace.tsx components/review-workspace.tsx components/level-assessment.tsx components/learning-report.tsx lib/practice-materials.ts",
    "start:local": "node --experimental-strip-types scripts/serve-local.mjs",
    "test:library": "node --experimental-strip-types --test scripts/library.test.mjs",
    "test:practice": "node --experimental-strip-types --test scripts/practice.test.mjs",
    "test:review": "node scripts/review.test.mjs",
    "test:assessment": "node scripts/assessment.test.mjs",
    "test:providers": "node scripts/provider.test.mjs",
    "test:analytics": "node scripts/analytics.test.mjs",
    "db:init": "node scripts/init-database.mjs",
    "test:library:sqlite": "node --experimental-strip-types --test scripts/sqlite-library.test.mjs",
    "test:library:integration": "node --experimental-strip-types --test scripts/library-integration.test.mjs",
    "test:library:edit": "node --experimental-strip-types --test scripts/library-edit.test.mjs",
    "test:library:organization": "node --experimental-strip-types --test scripts/library-organization.test.mjs",
    "test:cloud-library": "node --experimental-strip-types --test scripts/cloud-library.test.mjs",
    "test:cloud-migrations": "node scripts/cloud-migration-smoke.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "miniflare": "4.20260515.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
